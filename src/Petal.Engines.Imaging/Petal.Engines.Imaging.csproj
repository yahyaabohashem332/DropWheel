<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Petal.Core\Petal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DropWheel's own Magick.Native-Q8-x64: built without libde265 and OpenH264 (patented codecs); libheif stays
         for AVIF. HEIC read via Windows WIC (WindowsHeif.cs), HEIC write via FFmpeg hevc_mf (HeifWriter.cs).
         Fetched by tools/scripts/fetch-tools.ps1 from a dropwheel-magick release, pinned by SHA-256. -->
    <None Include="..\..\tools\bin\magick\Magick.Native-Q8-x64.dll">
      <Link>Magick.Native-Q8-x64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" GeneratePathProperty="true" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Petal.Engines.Imaging.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
