<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Petal.Core\Petal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Petal.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <!-- Disc images: UDF (Windows and DVD discs) and ISO 9660 read, ISO 9660 with Joliet written. MIT. -->
    <PackageReference Include="LTRData.DiscUtils.Udf" Version="1.0.91" />
    <!-- .tar.xz written: liblzma (0BSD) through its MIT wrapper. -->
    <PackageReference Include="Joveler.Compression.XZ" Version="5.0.2" />
    <!-- 3D models: glTF and GLB read and written (MIT); the picture of a model is drawn with SkiaSharp. -->
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.7" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.150.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
