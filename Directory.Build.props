<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>Petal</Company>
    <Product>Petal</Product>
    <Version>1.0.0</Version>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Petal's own words are in its code (English and its translations). Of the packages' translated resources only
         WPF's stay, in the languages it has (8 MB): its text boxes' menus follow the language Windows shows. -->
    <SatelliteResourceLanguages>en;cs;de;es;fr;it;ja;ko;pl;pt-BR;ru;tr;zh-Hans;zh-Hant</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
