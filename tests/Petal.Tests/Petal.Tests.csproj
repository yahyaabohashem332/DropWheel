<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- For System.Drawing, which File Explorer's thumbnail reader uses; its global usings would clash with WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- File Explorer's thumbnail reader, built for .NET Framework 4.8 in the app, tested here as source. -->
  <ItemGroup>
    <Compile Include="..\..\src\Petal.Shell\*.cs" LinkBase="Shell" />
    <!-- RAR and 7z archives built byte by byte, shared with the documents tests' comic books. -->
    <Compile Include="..\Petal.Engines.Documents.Tests\BookSamples.cs" Link="Archives\BookSamples.cs" />
    <PackageReference Include="Svg" Version="3.4.8" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Petal.Core\Petal.Core.csproj" />
    <ProjectReference Include="..\..\src\Petal.Engines.Imaging\Petal.Engines.Imaging.csproj" />
    <ProjectReference Include="..\..\src\Petal.Engines.Media\Petal.Engines.Media.csproj" />
    <ProjectReference Include="..\..\src\Petal.Engines.Documents\Petal.Engines.Documents.csproj" />
    <ProjectReference Include="..\..\src\Petal.Engines.Files\Petal.Engines.Files.csproj" />
    <ProjectReference Include="..\..\src\Petal.App\Petal.App.csproj" />
    <!-- Built for the test that runs the File Explorer extension in a .NET Framework 4.8 process, as Windows does. -->
    <ProjectReference Include="..\Petal.ShellHost\Petal.ShellHost.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PlatformTarget" />
    <ProjectReference Include="..\..\src\Petal.Cli\Petal.Cli.csproj" />
  </ItemGroup>

  <!-- Helper programs shipped with Petal: tools\bin is filled by tools\scripts\fetch-tools.ps1 and copied next to the exe. -->
  <ItemGroup Condition="Exists('..\..\tools\bin\exiftool\exiftool.exe')">
    <None Include="..\..\tools\bin\exiftool\**\*" LinkBase="tools\exiftool" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\tools\bin\models')">
    <None Include="..\..\tools\bin\models\**\*" LinkBase="tools\models" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- The helper programs Petal ships, so tests exercise those builds rather than any on the PATH. -->
  <ItemGroup Condition="Exists('..\..\tools\bin\ffmpeg\ffmpeg.exe')">
    <None Include="..\..\tools\bin\ffmpeg\*" LinkBase="tools\ffmpeg" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\tools\bin\exiftool\exiftool.exe')">
    <None Include="..\..\tools\bin\exiftool\**\*" LinkBase="tools\exiftool" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>